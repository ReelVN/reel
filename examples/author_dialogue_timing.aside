fn main() {
    game.configure(fonts: ["fonts/body.ttf"], text_speed: 30);
    let dialogue = game.dialogue();
    let reading = game.reading();
    stage.replace(stack(width: 1280, height: 720, background: "#172331") {
        text(value: bind(dialogue.text), reveal: bind(dialogue.reveal),
            x: 100, y: 480, width: 1080, font_size: 32);
        text("▸", x: 1160, y: 650, font_size: 28,
            visible: derive(|| dialogue.ready && !reading.auto && !reading.skipping && !reading.paused));
    });
    let mio = character("Mio");
    mio(rich("[speed=0]门后传来了声音。[/speed][pause=0.5] [speed=12]你也听见了吗？[/speed]"));
    mio(rich("[speed=2x]快走！[/speed][pause=0.3][next]"));
    mio(rich("等等……[pause=1][b]有人在叫我的名字。[/b]"));
}
