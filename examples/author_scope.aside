// Run with: reel dev examples/author_scope.aside
fn main() {
    game.configure(title: "One lifetime for an effect", width: 640, height: 360);
    let state = model({turns: 0});
    let job = {value: null};
    let panel = stack(width: 220, height: 90, background: "#b64b72");
    let root = column(gap: 16, padding: 24) {
        panel;
        text(value: derive(|| f"Scope ticks: {state.turns}"));
    };
    let start = || {
        if job.value != null { job.value.cancel(); }
        job.value = spawn(|| scope(body: |s| {
            await stage.presented();
            s.run(repeat(sequence(
                tween(panel, opacity: 0.25, duration: 0.4),
                tween(panel, opacity: 1, duration: 0.4)
            )));
            s.spawn(|| {
                loop { await run(delay(0.2)); state.turns += 1; }
            });
            await completion();
        }), owner: root);
    };
    root.add(row(gap: 12) {
        button("Start", on_click: start);
        button("Stop", on_click: || {
            if job.value != null { job.value.cancel(); job.value = null; }
        });
    });
    stage.replace(root);
}
