let visits = model({count: 0});

fn title() {
    stage.replace(column(x: 80, y: 80, gap: 20) {
        text("A fresh story", font_size: 36);
        text(value: derive(|| f"Session visits: {visits.count}"));
        button("New game", on_click: |event| game.start(opening));
        button("Exit", on_click: |event| game.exit());
    });
}

fn opening() {
    visits.count += 1;
    let dialogue = game.dialogue();
    stage.replace(column(x: 80, y: 80, gap: 20) {
        text(value: bind(dialogue.text), reveal: bind(dialogue.reveal), width: 800);
        button("Main menu", on_click: |event| game.start(title));
    });
    narrator("Return to the title screen at any time. A new game has fresh globals.");
    game.start(title);
}

fn main() {
    game.configure(width: 1280, height: 720, fonts: ["fonts/body.ttf"]);
    title();
}
