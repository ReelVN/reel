// The bundled chime lasts 0.25 seconds. Use your music and cue times for a longer scene.
fn main() {
    game.configure(title: "Music drives the scene", width: 560, height: 180,
        fonts: ["fonts/body.ttf"]);
    let panel = stack(width: 560, height: 180, background: "#142232");
    let music = audio.play("assets/chime.wav", group: "music", owner: panel);
    pause(music);
    let position = derive(|| audio.position(music));
    let caption = text("Waiting for the cue", x: 32, y: 108, color: "#ffffff");
    panel.add(stack(x: 32, y: 56, width: 424, height: 24, background: "#30465c") {
        stack(x: derive(|| position.value * 1600), width: 24, height: 24,
            background: "#73dac3");
    });
    panel.add(caption);
    stage.replace(panel);
    await stage.presented(owner: panel);
    resume(music);
    let reached = await audio.at(music, 0.125);
    caption.value = if reached { "The music reached the cue" } else { "Playback ended before the cue" };
    await music;
}
