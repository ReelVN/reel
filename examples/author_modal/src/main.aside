fn main() {
    game.configure(fonts: ["fonts/body.ttf"]);
    let status = text("Ready", x: 24, y: 96, width: 300, height: 40);
    let menu = column(
        x: 260, y: 24, width: 220, gap: 12, padding: 16, background: "#284860", modal: true,
        visible: false
    );
    menu.add(
        button(
            "Confirm", width: 180, height: 48,
            on_click: |event| {
                status.value = "Confirmed";
            }
        )
    );
    menu.add(
        button(
            "Close", width: 180, height: 48,
            on_click: |event| {
                menu.visible = false;
            }
        )
    );
    stage.replace(
        stack() {
            button(
                "Open menu", x: 24, y: 24, width: 180, height: 48,
                on_click: |event| {
                    menu.visible = true;
                }
            );
            status;
            menu;
        }
    );
    narrator("Open the menu. The story waits while you use it.");
    status.value = "Story continued";
    narrator("Closing the menu returns input to the story.");
}
