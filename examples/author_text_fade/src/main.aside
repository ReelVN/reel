fn main() {
    game.configure(
        title: "Progressive text opacity", width: 800, height: 240, fonts: ["fonts/body.ttf"]
    );
    let caption = text(
        "The light is moving.", reveal_fade: 0, reveal_fade_from: 0, reveal_fade_step: 20.0 / 255.0
    );
    stage.replace(caption);
    await run(tween(caption, reveal_fade: 3, duration: 3.0 * 255.0 / 1400.0), owner: caption);
    caption.reveal_fade = null;
}
