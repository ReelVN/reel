fn main() {
    game.configure(title: "Timed conversation", width: 800, height: 450, fonts: "fonts/body.ttf");
    let panel = text("Waiting for a reply...", x: 40, y: 40);
    stage.replace(panel);
    await run(delay(1.5));
    panel.value = "A reply arrived.";
    await run(sequence(delay(0.5), tween(panel, opacity: 0, duration: 0.3)));
}
