fn main() {
    let state = model({ wrap: false });
    stage.replace(
        column(width: 620, padding: 24, gap: 16) {
            text("Automatic line wrapping", font_size: 28);
            checkbox("Wrap the paragraph", value: bind(state.wrap));
            text(
                "A long authored line without automatic wrapping.\nA second explicit line.",
                width: 240, text_wrap: derive(|| state.wrap), clip: true, background: "#28303d",
                padding: 8
            );
            text(
                "This complete title shrinks to fit its width.", width: 240, text_wrap: false,
                text_fit: "shrink", min_font_size: 12
            );
        }
    );
}
