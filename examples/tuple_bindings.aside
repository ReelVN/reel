fn main() {
    let callbacks = [];
    for (key, (left, right)) in [("first", (1, 2)), ("second", (3, 4))] {
        callbacks.append(|| (key, left + right));
    }
    let (name, total) = callbacks[1]();
    let values = {name: name, total: total};
    for (key, value) in values.entries() { let (_, result) = (key, value); }
}
