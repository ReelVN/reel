fn main() {
    game.configure(title: "Keyboard input", width: 800, height: 450, fonts: "fonts/body.ttf");
    let ui = model({status: "Press any key", name: ""});
    stage.replace(input(width: 800, height: 450,
        on_key: |event| { ui.status = f"{event.code}: {event.phase}"; }
    ) {
        text(value: bind(ui.status), x: 40, y: 40);
        text("The editor below owns typing and the system IME:", x: 40, y: 100);
        text_input(value: bind(ui.name), x: 40, y: 140, width: 400, height: 44,
                   padding: 6, background: "#ffffff", color: "#202020");
    });
}
