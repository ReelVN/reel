// Supply fonts/body.ttf relative to this source before opening a native window.
let inventory = model(
    {
        items: [
            { id: 0, label: "Letter", count: 1, expanded: false },
            { id: 1, label: "Brass key", count: 2, expanded: false }
        ],
        selected: "", even_only: false
    }
);

fn visible_items() {
    if !inventory.even_only {
        return inventory.items;
    }
    let result = [];
    for item in inventory.items {
        if item.id % 2 == 0 {
            result.append(item);
        }
    }
    result
}

fn item_view(row) {
    // Persistent item state belongs to the model, including while offscreen.
    column(gap: 8) {
        button(
            width: 500, height: 50,
            on_click: |event| {
                inventory.selected = row.value.label;
                row.value.expanded = !row.value.expanded;
            }
        ) {
            text(value: derive(|| f"{row.index + 1}. {row.value.label} × {row.value.count}"));
        }
        text(
            value: derive(
                || f"Selected: {row.value.label}\nThe item's expanded state stays in the model while its component is offscreen."
            ),
            width: 500, visible: derive(|| row.value.expanded)
        );
        text(
            value: derive(
                || f"Collection note for {row.value.label}\nSome entries contain a longer description."
            ),
            width: 500, visible: row.value.id % 3 == 0
        );
    }
}

pub fn main() {
    game.configure(fonts: ["fonts/body.ttf"], width: 1000, height: 720);
    let mut i = 2;
    while i < 1000 {
        inventory.items.append(
            { id: i, label: f"Collection item {i}", count: i % 7 + 1, expanded: false }
        );
        i += 1;
    }
    let items = list(visible_items, key: |item| item.id, virtual: true, build: item_view, gap: 16);
    stage.replace(
        column(x: 40, y: 30, width: 900, gap: 20) {
            row(gap: 16) {
                button(
                    "Item 998",
                    on_click: |e| {
                        try {
                            await items.scroll_to(998, align: "center");
                            inventory.selected = "Positioned at item 998";
                        } catch error {
                            inventory.selected = "Positioning cancelled";
                        }
                    }
                );
                button("Reverse", on_click: |e| inventory.items.reverse());
                button(
                    "Even IDs / all",
                    on_click: |e| {
                        inventory.even_only = !inventory.even_only;
                    }
                );
                button(
                    "Replace letter",
                    on_click: |e| {
                        let mut i = 0;
                        for item in inventory.items {
                            if item.id == 0 {
                                inventory.items[i] = {
                                    id: 0, label: "Opened letter", count: item.count,
                                    expanded: item.expanded
                                };
                                break;
                            }
                            i += 1;
                        }
                    }
                );
            }
            scroll(width: 880, height: 360) {
                items;
            }
            text(value: derive(|| f"Last selection: {inventory.selected}"));
            text(
                "Tab / arrow keys move between items; Enter selects and expands. Filter, reverse, or scroll away and back to keep each item's state.",
                width: 880
            );
        }
    );
    narrator("展开一项，再过滤、排序、替换记录或滚动离开：它的状态仍然保留。");
}
