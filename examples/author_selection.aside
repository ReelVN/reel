fn language_option(option, label, selected) {
    let control = radio(option, label, value: selected, width: 260, height: 52,
        decorated: false, color: "#ffffff");
    control.background = derive(|| if control.value == control.option { "#345b85" }
        else if control.hover || control.focused { "#293b52" } else { "#182536" });
    control
}

fn main() {
    game.configure(title: "Selection controls", width: 720, height: 480,
        fonts: ["fonts/body.ttf"]);
    let settings = model({sound: true, captions: true, language: "zh-CN"});
    stage.replace(column(padding: 28, gap: 16) {
        text("Reading preferences", font_size: 32);
        text("Tab visits each group once. Arrow keys select a language.", font_size: 18);
        checkbox("Sound", value: bind(settings.sound), width: 260, height: 40);
        checkbox("Captions", value: bind(settings.captions), width: 260, height: 40);
        row(gap: 12) {
            language_option("zh-CN", "简体中文", bind(settings.language));
            language_option("en", "English", bind(settings.language));
        }
        text(derive(|| f"Selected: {settings.language}"));
        button("Reset", width: 260, height: 40, on_click: |event| {
            settings.sound = true;
            settings.captions = true;
            settings.language = "zh-CN";
        });
    });
}
