fn main() {
    game.configure(title: "Field notes", width: 640, height: 420, fonts: "fonts/body.ttf");
    let notes = model({ body: "The door opens.\nWhat happens next?", saved: "" });
    let save = || {
        notes.saved = notes.body;
    };
    let editor = text_area(
        value: bind(notes.body), width: 560, height: 220, padding: 16, background: "#182638",
        font_size: 24, on_submit: save
    );
    stage.replace(
        column(padding: 24, gap: 16) {
            text("Field notes", font_size: 28);
            editor;
            row(gap: 16) {
                button("Keep notes", width: 160, height: 40, on_click: save);
                text(
                    derive(
                        || if notes.body == notes.saved {
                            "Saved"
                        } else {
                            "Editing"
                        }
                    )
                );
            };
        }
    );
}
