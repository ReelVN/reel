fn main() {
    game.configure(title: "Shared author state", width: 960, height: 540,
        fonts: ["fonts/body.ttf"]);
    let settings = model({
        caption: "One model, several views",
        progress: 160,
        details: true,
        palette: {accent: "#70d890"}
    });
    stage.replace(column(gap: 20, padding: 28, width: 960, height: 540) {
        text(bind(settings.caption), font_size: 28);
        slider(value: bind(settings.progress), min: 0, max: 320, width: 320);
        stack(width: bind(settings.progress), height: 12,
            background: bind(settings.palette.accent));
        toggle(label: "Show details", value: bind(settings.details));
        text("The slider and this bar share the same data.", visible: bind(settings.details));
        button("Change palette", on_click: |event| {
            settings.caption = "The views followed the model";
            settings.palette.accent = "#ffd580";
        });
    });
    narrator("Controls write back to the model; connected views follow automatically.");
}
