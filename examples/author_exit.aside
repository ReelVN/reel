fn main() {
    game.configure(title: "退出演出", fonts: "fonts/body.ttf", width: 1280, height: 720);
    let cover = stack(width: 1280, height: 720, background: "#000000", opacity: 0);
    let quit = button("退出", x: 540, y: 320, width: 200, height: 70,
        on_click: |event| {
            event.target.enabled = false;
            await run(tween(cover, opacity: 1, duration: 0.5));
            game.exit();
        });
    stage.replace(stack() { quit; cover; });
}
