fn main() {
    game.configure(
        title: "Content-sized frame", width: 720, height: 480, fonts: ["fonts/body.ttf"]
    );
    let state = model({ expanded: false });
    stage.replace(
        stack(width: 720, height: 480) {
            stack(max_width: 420, align_x: 0.5, align_y: 0.5) {
                image("images/panel.png", stretch: "both", slice: 12);
                column(padding: 24, gap: 16) {
                    text(
                        value: derive(
                            || if state.expanded {
                                "The frame follows wrapped text.\nChanging content keeps the same background and input controls."
                            } else {
                                "The frame follows its content."
                            }
                        ),
                        font_size: 24, align_x: 0.5, text_align: "center"
                    );
                    button(
                        "Change text", align_x: 0.5,
                        on_click: |event| {
                            state.expanded = !state.expanded;
                        }
                    );
                }
            }
        }
    );
}
