fn name_form() {
    let data = model({name: ""});
    let root = column(x: 60, y: 60, gap: 16);
    let result = completion(owner: root);
    root.add(text("你的名字", font_size: 28));
    root.add(text_input(value: bind(data.name), width: 300));
    root.add(button("确认", on_click: |event| result.resolve(data.name)));
    return {root: root, result: result};
}

fn counting_game(name: string) {
    let data = model({score: 0});
    let root = column(x: 60, y: 60, gap: 16);
    let result = completion(owner: root);
    root.add(text(f"{name}，试试自己的小游戏。", font_size: 28));
    root.add(text(derive(|| f"分数：{data.score}")));
    root.add(button("加一分", on_click: |event| { data.score += 1; }));
    root.add(button("完成", on_click: |event| result.resolve({score: data.score})));
    return {root: root, result: result};
}

fn main() {
    game.configure(title: "Component results", width: 800, height: 480,
        fonts: "fonts/body.ttf");
    let form = name_form();
    stage.replace(form.root);
    let name = await form.result;
    let game_view = counting_game(name);
    stage.replace(game_view.root);
    let result = await game_view.result;
    stage.replace(text(f"{name}，你的分数是 {result.score}。", x: 60, y: 60));
}
