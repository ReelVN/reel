fn main() {
    game.configure(fonts: ["font.ttf"]);
    let data = model({ score: 1, busy: false, status: "" });
    stage.replace(
        column(x: 40, y: 40, gap: 16) {
            text(value: derive(|| f"Score: {data.score}"));
            button(
                "Add",
                on_click: |event| {
                    data.score += 1;
                }
            );
            button(
                "Save", enabled: derive(|| !data.busy),
                on_click: |event| {
                    data.busy = true;
                    try {
                        let request = saves.save("quick", title: f"Score: {data.score}");
                        await request;
                        data.status = if request.restored {
                            "Loaded"
                        } else {
                            "Saved"
                        };
                    } catch error {
                        data.status = error;
                    }
                    data.busy = false;
                }
            );
            button(
                "Load", enabled: derive(|| !data.busy),
                on_click: |event| {
                    try {
                        await saves.load("quick");
                    } catch error {
                        data.status = error;
                    }
                }
            );
            text(value: bind(data.status));
        }
    );
}
