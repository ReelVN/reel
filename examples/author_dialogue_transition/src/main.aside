// Supply fonts/body.ttf relative to this file to open the native window.
fn dialogue_box() {
    let dialogue = game.dialogue();
    let content = column(width: 840, gap: 12) {
        text(
            value: bind(dialogue.speaker_name), font_size: 28,
            color: derive(
                || match dialogue.speaker_id {
                    "mio" => "#9ed8ff",
                    "eri" => "#ffb8d4",
                    _ => "#ffffff"
                }
            )
        );
        text(
            value: bind(dialogue.text), reveal: bind(dialogue.reveal), width: 840, font_size: 24,
            color: derive(
                || if dialogue.read {
                    "#aaaaaa"
                } else {
                    "#ffffff"
                }
            )
        );
    };
    let frame = stack(
        x: 40, y: 430, width: 920, height: 220, padding: 24, background: "#152030", clip: true
    ) {
        content;
    };
    return {
        node: frame,
        speak: |speaker, words| {
            content.y = 0;
            content.opacity = 1;
            speaker(words);
            // Advance completes the dialogue first; its displayed data stays available.
            await tween(content, y: -180, opacity: 0, duration: 0.2, easing: "in").run();
        }
    };
}

fn main() {
    game.configure(width: 1000, height: 720, fonts: ["fonts/body.ttf"], text_speed: 30);
    let dialogue = dialogue_box();
    stage.replace(dialogue.node);
    let mio = character("Mio", id: "mio");
    let eri = character("Eri", id: "eri");
    dialogue.speak(mio, "读完这一句后，文字会向上移出。然后再开始下一句。");
    dialogue.speak(eri, "姓名颜色、已读颜色与换句动画都由这个普通组件决定。");
}
