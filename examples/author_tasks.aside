class Bouncer {
    let node;
    let rng;

    fn init(self, node) {
        self.node = node;
        self.rng = random();
    }

    fn idle(self) {
        loop {
            await run(delay(1 + self.rng.float() * 2));
            await run(repeat(sequence(
                tween(self.node, y: 40, duration: 0.18, easing: "quad_out"),
                tween(self.node, y: 120, duration: 0.18, easing: "quad_in")
            ), times: 2));
        }
    }
}

fn main() {
    game.configure(title: "Scripted scene activities", width: 800, height: 480,
        fonts: ["fonts/body.ttf"]);
    let root = stack(width: 800, height: 480);
    let card = stack(x: 60, y: 120, width: 180, height: 100, background: "#4575a8") {
        text("等待中也在演出", x: 10, y: 32, font_size: 20);
    };
    let result = completion(owner: root);
    root.add(card);
    root.add(button("完成", x: 60, y: 300, on_click: |event| result.resolve("完成了")));
    stage.replace(root);
    let actor = Bouncer(card);
    let idle = spawn(actor.idle, owner: card);
    let value = await result;
    stage.replace(text(value, x: 60, y: 80));
    // Replacing the scene retires card and cancels its background task.
    try { await idle; } catch error {}
}
