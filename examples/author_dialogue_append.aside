// Supply fonts/body.ttf and assets/chime.wav before opening a native window.
let mio = character("Mio");
pub fn main() {
    game.configure(width: 800, height: 450, fonts:["fonts/body.ttf"]);
    let dialogue = game.dialogue();
    stage.replace(column(x:40,y:280,width:720,gap:12) {
        text(value:bind(dialogue.speaker_name),font_size:24);
        text(value:bind(dialogue.text),reveal:bind(dialogue.reveal),font_size:28);
    });
    let line = mio("Starting", wait: false);
    await run(delay(0.5));
    line.append(" ...");
    audio.play("assets/chime.wav");
    line.append(" ready.");
    line.wait();
    line.append("\nWelcome back.");
    line.wait();
    narrator("The next line retires the previous handle.");
}
