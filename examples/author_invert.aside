fn main() {
    game.configure(width: 800, height: 450);
    let scene = stack(width: 800, height: 450, background: "#204060", invert: 0) {
        text("A different view", color: "#e08020", font_size: 48);
    };
    stage.replace(stack(width: 800, height: 450) {
        scene;
        column(y: 300) {
            text("This caption keeps its colors.", color: "#ffffff");
            button("Toggle inversion", on_click: || {
                await run(tween(scene, invert: 1 - scene.invert, duration: 0.4), owner: scene);
            });
        };
    });
}
