// Run with: reel dev examples/author_cursor.aside
fn main() {
    game.configure(title: "A cursor made from stage nodes", width: 640, height: 420);
    let mark = stack(width: 22, height: 22, anchor_x: 0.5, anchor_y: 0.5) {
        stack(x: 9, width: 4, height: 22, background: "#ffe066");
        stack(y: 9, width: 22, height: 4, background: "#ffe066");
    };
    let pointer = cursor(width: 22, height: 22, children: [mark]);
    let panel = column(width: 320, height: 200, padding: 24, background: "#23435b") {
        text("Move the mouse here", color: "#ffffff");
        pointer;
    };
    let hidden = cursor(visible: false);
    panel.add(hidden);
    stage.replace(column(gap: 16, padding: 24) {
        panel;
        row(gap: 12) {
            button("Hide / show", width: 150, height: 44, on_click: || { hidden.visible = !hidden.visible; });
            button("Remove custom cursor", width: 230, height: 44, on_click: || { pointer.remove(); hidden.remove(); });
        };
    });
    run(repeat(sequence(
        tween(mark, opacity: 0.35, duration: 0.3),
        tween(mark, opacity: 1, duration: 0.3)
    )), owner: pointer);
}
