// Run reel dev from examples/author_offsets/.
fn main() {
    game.configure(title: "Move and shake independently", width: 640, height: 360);
    let state = model({ hits: 0, shaking: false });
    let job = { value: null };
    let panel = button(
        "Catch me", x: 40, y: 100, width: 100, height: 50,
        on_click: || {
            state.hits += 1;
        }
    );
    let shake = || {
        if job.value != null {
            job.value.cancel();
        }
        job.value = spawn(
            || {
                state.shaking = true;
                scope(
                    body: |s| {
                        let motion = s.offset(panel, y: -3);
                        await repeat(
                                sequence(
                                    tween(motion, x: 6, duration: 0.05),
                                    tween(motion, x: -6, duration: 0.05)
                                ), times: 8
                            ).run();
                    }
                );
                state.shaking = false;
            }
        );
    };
    stage.replace(
        stack(width: 640, height: 360) {
            panel;
            button("Shake", x: 24, y: 24, width: 100, height: 40, on_click: shake);
            button(
                "Stop shaking", x: 136, y: 24, width: 150, height: 40,
                on_click: || {
                    if job.value != null {
                        job.value.cancel();
                        job.value = null;
                    }
                    state.shaking = false;
                }
            );
            text(derive(|| f"Hits: {state.hits}"), x: 24, y: 220);
            text(
                derive(
                    || if state.shaking {
                        "Shaking while moving"
                    } else {
                        "Base movement continues"
                    }
                ),
                x: 24, y: 255
            );
        }
    );
    repeat(sequence(tween(panel, x: 360, duration: 4), tween(panel, x: 40, duration: 4))).run();
}
