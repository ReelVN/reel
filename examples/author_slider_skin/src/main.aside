fn music_slider(settings) {
    let control = slider(
        value: bind(settings.volume), width: 320, height: 36, decorated: false,
        on_change: |event| audio.group_volume("music", event.value)
    );
    control.add(stack(y: 15, width: 320, height: 6, background: "#44364e"));
    control.add(
        stack(y: 15, width: derive(|| control.value * 320), height: 6, background: "#e79ac4")
    );
    control.add(
        stack(
            x: derive(|| control.value * 320), y: 18, width: 16, height: 24, anchor_x: 0.5,
            anchor_y: 0.5,
            background: derive(
                || if control.hover || control.focus_visible {
                    "#ffffff"
                } else {
                    "#ffcee8"
                }
            )
        )
    );
    control
}

fn main() {
    game.configure(title: "Custom slider", width: 640, height: 360, fonts: ["fonts/body.ttf"]);
    let settings = model({ volume: 0.7 });
    stage.replace(
        column(x: 100, y: 90, gap: 20) {
            text("Music volume", font_size: 28);
            music_slider(settings);
            text(value: derive(|| f"{settings.volume}"));
        }
    );
}
