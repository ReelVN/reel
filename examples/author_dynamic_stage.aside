fn card(caption, shade) {
    column(width: 260, padding: 20, gap: 12, background: shade) {
        text(caption, font_size: 28);
        text("A reusable component", font_size: 18);
    }
}

fn main() {
    let cards = row(x: 40, y: 60, gap: 20) {
        card("Original", "#20304c");
    };
    stage.replace(cards);
    narrator("The mounted row keeps its identity while its contents change.");

    let incoming = cards.add(card("Added later", "#385030"));
    incoming.opacity = 0;
    await run(tween(incoming, opacity: 1, duration: 0.4));
    narrator("This card was added to the existing scene.");

    cards.add(card("Inserted first", "#503048"), index: 0);
    narrator("An explicit index controls layout and draw order.");
    let dismiss = incoming.remove;
    dismiss();
    narrator("Only the selected component was retired.");

    cards.clear();
    cards.add(card("Same container", "#285060"));
    narrator("The original row now owns new contents.");
}
