// Run with: reel dev examples/author_transition.aside
fn main() {
    game.configure(title: "Change the scene", width: 800, height: 450);
    let scene = stack(width: 740, height: 310, background: "#25364d") {
        text("An ordinary stage container", x: 32, y: 120, font_size: 32);
    };
    let state = model({busy: false, evening: false, clicks: 0});
    let change = |wipe| {
        state.busy = true;
        try {
            stage.transition(target: scene, duration: 1.2, mask: wipe, change: || {
                state.evening = !state.evening;
                scene.clear();
                scene.background = if state.evening { "#773955" } else { "#25364d" };
                scene.add(text(
                    if state.evening { "Evening has arrived" } else { "A new day begins" },
                    x: 32, y: 120, font_size: 32));
            });
        } finally {
            state.busy = false;
        }
    };
    stage.replace(column(padding: 30, gap: 16, width: 800, height: 450) {
        scene;
        row(gap: 12) {
            button("Dissolve", enabled: derive(|| !state.busy),
                on_click: || change(null));
            button("Image wipe", enabled: derive(|| !state.busy),
                on_click: || change("assets/mask-waves.png"));
            button(label: derive(|| f"Outside the scene: {state.clicks}"),
                on_click: || { state.clicks += 1; });
        }
    });
}
