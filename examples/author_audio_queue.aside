fn main() {
    game.configure(fonts: ["fonts/body.ttf"]);
    // Replace these bundled clips with your own intro, loop, and outro files.
    let music = audio.play("assets/chime.wav", group: "music", volume: 0.4);
    audio.queue(music, "assets/chime.wav", looping: true, loop_start: 0.05, loop_end: 0.2);
    narrator("Intro then loop. Continue to leave the current loop pass and play the outro.");
    audio.queue(music, "assets/chime.wav", start: 0.1, end: 0.2);
    await music;

    // The same activity can join separate narration clips without main-thread gaps.
    let voice = audio.play("assets/chime.wav", group: "voice", end: 0.1);
    audio.queue(voice, "assets/chime.wav", start: 0.1, end: 0.2);
    audio.queue(voice, "assets/chime.wav", start: 0.2);
    await voice;
    narrator("All clips have completed. Save/restore retains the current clip and remaining order.");
}
