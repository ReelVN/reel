// Supply fonts/body.ttf to open the native window.
pub fn main() {
    game.configure(fonts: ["fonts/body.ttf"], width: 640, height: 480);
    let status = text("Scroll the content, then continue at either boundary.", x: 20, y: 20);
    stage.replace(
        input(
            width: 640, height: 480,
            on_wheel: |event| {
                status.value = f"Boundary wheel: {event.delta_y}; local position {event.x}, {event.y}";
            }
        ) {
            status;
            scroll(x: 20, y: 70, width: 600, height: 360) {
                column(gap: 20) {
                    for index in 0 .. 30 {
                        text(f"Line {index + 1}", font_size: 28);
                    }
                }
            }
        }
    );
}
