use std::time::{ now, parts, format };

fn main() {
    game.configure(fonts: ["fonts/body.ttf"]);
    let display = model({ local: "", utc: "" });
    let panel = column(x: 80, y: 80, gap: 20) {
        text(value: bind(display.local));
        text(value: bind(display.utc));
    };
    stage.replace(panel);
    spawn(
        || {
            loop {
                let timestamp = now();
                display.local = format(timestamp);
                display.utc = format(timestamp, pattern: "%Y-%m-%d %H:%M:%S UTC", timezone: "UTC");
                // Scheduling belongs to Reel; the standard library only reads time.
                await run(delay(1));
            }
        },
        owner: panel
    );
}
