fn main() {
    game.configure(
        title: "Shared scene properties", width: 960, height: 540, fonts: ["fonts/body.ttf"]
    );
    let shown = toggle("Show the scene", value: true, width: 260, height: 44);
    let position = slider(value: 100, min: 0, max: 400, width: 400, height: 44);
    let mirror = slider(value: bind(position.value), min: 0, max: 400, width: 400, height: 44);
    let picture = stack(
        x: bind(position.value), width: 160, height: 90, background: "#5875c7", padding: 12
    ) {
        text("Move me", font_size: 22);
    };
    stage.replace(
        column(gap: 12, padding: 24, width: 960, height: 540) {
            shown;
            position;
            mirror;
            stack(visible: bind(shown.value), width: 800, height: 140) {
                picture;
            }
            button(
                "Detach the second slider",
                on_click: |event| {
                    unbind(bind(mirror.value));
                }
            );
            button(
                "Reconnect",
                on_click: |event| {
                    mirror.value = bind(position.value);
                }
            );
        }
    );
    narrator("Both sliders and the picture share a value without synchronization callbacks.");
}
