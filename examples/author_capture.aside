fn main() {
    game.configure(width: 1280, height: 720, fonts: ["font.ttf"]);
    let ui = model({busy: false, preview: null, status: ""});
    stage.replace(stack(width: 1280, height: 720, background: "#203849") {
        column(x: 40, y: 40, gap: 16) {
            text("Frame capture and save preview", font_size: 32);
            button("Save with preview", enabled: derive(|| !ui.busy), on_click: |event| {
                ui.busy = true;
                try {
                    let thumbnail = await stage.capture(width: 256, height: 144);
                    let request = saves.save("quick", title: "Captured scene", thumbnail: thumbnail);
                    await request;
                    ui.status = if request.restored { "Loaded" } else { "Saved" };
                    ui.preview = await saves.thumbnail("quick");
                } catch error { ui.status = f"{error}"; }
                ui.busy = false;
            });
            button("Load", enabled: derive(|| !ui.busy), on_click: |event| {
                try { await saves.load("quick"); }
                catch error { ui.status = f"{error}"; }
            });
            text(value: bind(ui.status));
        }
        view(|| if ui.preview == null { null }
            else { image(ui.preview, x: 800, y: 40, width: 256, height: 144) });
    });
}
