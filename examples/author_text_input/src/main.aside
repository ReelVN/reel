fn main() {
    game.configure(title: "Text input", width: 800, height: 450, fonts: "fonts/body.ttf");
    let profile = model({ name: "", submitted: "" });
    stage.replace(
        column(x: 40, y: 40, gap: 16) {
            text("Enter your name:");
            text_input(
                value: bind(profile.name), width: 360, height: 44, padding: 6, color: "#202020",
                background: "#ffffff",
                on_submit: |event| {
                    profile.submitted = event.value;
                }
            );
            text(value: derive(|| f"Name: {profile.name}"));
            text(value: derive(|| f"Submitted: {profile.submitted}"));
        }
    );
}
