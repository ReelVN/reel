fn main() {
    game.configure(fonts: ["fonts/body.ttf"]);
    let base = { message: "窗上的光", x: 32, y: 48 };
    let opening = [base];
    let captions = [
        ...opening, { ...base, message: "复制布局，再改动这一句。", y: 90, color: "#ffcc88" },
        { ...base, message: "数组组合顺序，表组合内容。", y: 132 },
    ];
    captions.sort(compare: |a, b| a.y - b.y);
    let opening_index = captions.find(base);
    captions[1].remove("color");
    stage.replace(
        stack() {
            for caption in captions {
                text(
                    caption.message, x: caption.x, y: caption.y,
                    color: caption.get("color", default: "#ffffff")
                );
            }
        }
    );
    narrator(f"{captions.len()} 句文字，起点位于索引 {opening_index}。");
}
