fn scrollbar(viewport, x, height) {
    fn clamp(value, low, high) { if value < low { low } else if value > high { high } else { value } }
    let drag = model({grab: 0});
    let thumb_height = derive(|| if viewport.content_height <= height { height }
        else { height * height / viewport.content_height });
    let thumb_y = derive(|| if viewport.content_height <= height { 0 }
        else { clamp(viewport.scroll_y / (viewport.content_height-height), 0, 1) * (height-thumb_height.value) });
    let track = input(x: x, width: 24, height: height, background: "#203040",
        on_pointer: |event| {
            if event.phase == "pressed" {
                drag.grab = if event.y >= thumb_y.value && event.y <= thumb_y.value+thumb_height.value {
                    event.y-thumb_y.value
                } else { thumb_height.value/2 };
            }
            if event.phase == "pressed" || event.phase == "moved" {
                if viewport.content_height > height {
                    viewport.scroll_y = clamp((event.y-drag.grab)/(height-thumb_height.value), 0, 1)*(viewport.content_height-height);
                }
            }
        });
    track.add(stack(y: thumb_y, width: 24, height: thumb_height,
        background: derive(|| if track.pressed { "#e0b060" } else if track.hover { "#90c0e0" } else { "#6090b0" })));
    track
}

fn main() {
    game.configure(fonts: ["font.ttf"]);
    let page = scroll(width: 360, height: 240, content_align: "end", follow_end: true) {
        for index in 0..20 { text(f"Line {index+1}", height: 40); }
    };
    stage.replace(stack(x: 30, y: 30) {
        page;
        scrollbar(page, 370, 240);
        button("Append", y: 260, on_click: |e| page.add(text("New line", height: 40)));
        button("Back to top", x: 160, y: 260, on_click: |e| {
            await run(tween(page, scroll_y: 0, duration: 0.5, easing: "out"), owner: page);
        });
    });
}
