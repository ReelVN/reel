fn main() {
    game.configure(width: 640, height: 360, fonts: ["fonts/body.ttf"]);
    let status = text("Click Move while using a mouse.", x: 24, y: 24);
    let root = stack(width: 640, height: 360);
    root.add(status);
    root.add(button("Move pointer", x: 24, y: 100, width: 180, height: 60, on_click: |event| {
        let moved = await stage.move_pointer(440, 120, owner: root);
        status.value = if moved { "The pointer moved through ordinary hit testing." }
            else { "Pointer movement is unavailable for the current input or host." };
    }));
    root.add(button("Destination", x: 400, y: 100, width: 180, height: 60,
        on_click: |event| { status.value = "Destination clicked."; }));
    stage.replace(root);
}

