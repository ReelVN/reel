// Supply fonts/body.ttf relative to the asset root.
// A sibling overlay can follow a transformed game object or a gallery thumbnail.
fn main() {
    game.configure(
        title: "Accepted node geometry", width: 800, height: 520, fonts: ["fonts/body.ttf"],
        text_speed: 0
    );
    let thumbnail = stack(
        x: 180, y: 160, width: 160, height: 100, rotation: -12, background: "#559dba"
    );
    let indicator = text("Here", anchor_x: 0.5, anchor_y: 1, color: "#ffffff");
    let overlay = stack(width: 800, height: 520, visible: false) {
        indicator
    };
    let root = stack(width: 800, height: 520, background: "#182536") {
        thumbnail;
        overlay;
    };
    stage.replace(root);
    await stage.presented(owner: root);
    overlay.visible = true;
    overlay.opacity = 0;
    let geometry = await stage.geometry(thumbnail, relative_to: overlay, owner: root);
    indicator.x = geometry.bounds.x + geometry.bounds.width / 2;
    indicator.y = geometry.bounds.y;
    overlay.opacity = 1;
    narrator("The label follows the accepted picture, including its rotation.");
}
