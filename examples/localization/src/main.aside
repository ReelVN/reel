fn unread_messages(count: int) -> string {
    if count == 1 {
        tr("1 条新消息", {en: "One new message"})
    } else {
        tr(f"{count} 条新消息", {en: f"{count} new messages"})
    }
}

fn main() {
    game.configure(fonts: ["fonts/body.ttf"]);
    localization.set_locale("zh-CN");
    let data = model({ name: "Mio", count: 2 });
    stage.replace(
        column(gap: 12) {
            text(value: derive(|| tr(f"你好，{data.name}。", {en: f"Hello, {data.name}."})));
            text(
                value: derive(
                    || unread_messages(data.count)
                )
            );
            button("中文", on_click: |event| localization.set_locale("zh-CN"));
            button("English", on_click: |event| localization.set_locale("en"));
            button("English (US)", on_click: |event| localization.set_locale("en-US"));
            button("+1", on_click: |event| { data.count += 1; });
        }
    );
    narrator(tr("雨停了。", {en: "The rain stopped."}));
}
