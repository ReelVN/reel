
fn card(title, accent, children = []) {
    column(width: 264, height: 202, padding: 20, gap: 14,
           background: "#1b2a40") {
        row(gap: 10) {
            stack(width: 4, height: 26, background: accent);
            text(title, font_size: 23, color: accent);
        }
        for child in children { child; }
    }
}

pub fn main() {
    let title = text("画面，由你定义", font_size: 40);
    let subtitle = text("空间 · 文字 · 节奏", font_size: 18, color: "#aab8cb");
    let glow = stack(x: 620, y: 0, width: 340, height: 160,
                     background: "#264764", opacity: 0.45);
    let scene = stack(width: 960, height: 540, background: "#101b2c") {
        glow;
        column(x: 64, y: 34, gap: 14) {
            text("REEL  /  COMPOSE YOUR STORY", font_size: 13, color: "#73dac3");
            title;
            subtitle;
            row(gap: 20) {
                card("空间", "#73dac3") {
                    text("层叠，也可以留白。", font_size: 18);
                    text("组件就是普通函数。", font_size: 16, color: "#aab8cb");
                }
                card("文字", "#eac184") {
                    for word in ["一行标题", "几句低语", "同一种表达"] {
                        text(word, font_size: 18);
                    }
                }
                card("节奏", "#a9b8ff") {
                    if true {
                        text("让变化发生在此刻。", font_size: 18);
                    }
                    text("每个节点，都有自己的位置。", font_size: 16, color: "#aab8cb");
                }
            }
        }
    };
    stage.replace(scene);
    narrator("先让画面停留片刻。");
    title.value = "同一幅画面，新的语气";
    title.color = "#73dac3";
    subtitle.value = "修改的是原来的节点，组件与层次继续保留。";
    glow.opacity = 0.8;
    glow.x = 600;
    narrator("现在，标题和光线都回应了这段故事。");
}
