/// Create a label with an optional position and a caller-selected constructor.
fn label_at(message, position: (int, int) | null = null, create = text) {
    let point: (int, int) = if position is null {
        (32, 48)
    } else {
        position
    };
    let node = create(message);
    node.x = point[0];
    node.y = point[1];
    node
}

fn main() {
    game.configure(fonts: ["fonts/body.ttf"]);
    let dialogue = game.dialogue();
    stage.replace(
        stack() {
            label_at("函数可以保存、传递，也可以作为缺省参数。");
            label_at("坐标使用 (int,int)，省略时采用缺省位置。", (32, 90), text);
            text(bind(dialogue.text), reveal: bind(dialogue.reveal), x: 32, y: 150, width: 900);
        }
    );
    let say = narrator;
    say("通过函数变量调用旁白，照常等待点击后继续。");
}
