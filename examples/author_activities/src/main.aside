fn main() {
    game.configure(fonts: ["fonts/body.ttf"]);
    let card = stack(width: 420, height: 220, x: 80, y: 120, opacity: 0, background: "#27395d") {
        text("雨后的窗边", x: 32, y: 32, font_size: 36);
        text("同一组节点，同时承担画面与演出。", x: 32, y: 100);
    };
    stage.replace(card);
    let entrance = parallel(
        tween(card, from: { opacity: 0 }, opacity: 1, duration: 0.5, easing: "quart_in"),
        tween(card, from: { x: 80 }, x: 220, duration: 0.8, easing: "elastic_out"),
        tween(card, from: { y: 120 }, y: 180, duration: 1.2, easing: "bounce_out")
    );
    await entrance.run();

    // Animation continues while dialogue waits for input.
    let sway = sequence(
        tween(card, x: 240, rotation: 2, duration: 2, easing: "in_out"),
        tween(card, x: 220, rotation: 0, duration: 2, easing: "in_out"),
    );
    let drift = repeat(sway).run(owner: card);
    narrator("窗外的雨渐渐停了。");
    drift.pause();
    narrator("画面停在此刻。继续后让它回到原位。");

    // A new activity takes over these properties and settles the old one as Stopped.
    await tween(card, x: 220, rotation: 0, duration: 0.5, easing: "in_out").run();
    narrator("写作时只需描述画面应该如何变化。");
    await tween(card, opacity: 0, duration: 0.4).run();
    // Reuse the authored starting values for another entrance after the delay.
    await sequence(delay(0.5), entrance).run();
    narrator("同一个入场动作，也可以留给重播按钮。");
}
