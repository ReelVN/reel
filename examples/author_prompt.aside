class Prompt {
    let node = stack(stretch: "both");
    let state = model({request: null});

    fn ask(self, message: string) {
        if self.state.request != null && self.state.request.pending { return null; }
        scope(owner: self.node, body: |s| {
            let result = completion();
            self.state.request = result;
            s.add(self.node, input(stretch: "both", modal: true,
                background: "#00000099",
                bindings: {back: [binding("Escape"), binding("East")]},
                on_action: |event| { if event.phase == "released" { result.resolve(null); } }) {
                column(align_x: 0.5, align_y: 0.5, gap: 20, padding: 32,
                    background: "#283249") {
                    text(message, font_size: 28);
                    row(gap: 20) {
                        button("Confirm", on_click: || result.resolve(true));
                        button("Back", on_click: || result.resolve(null));
                    };
                };
            });
            await result
        })
    }
}

fn main() {
    game.configure(title: "Scoped prompt", width: 800, height: 480,
        fonts: "fonts/body.ttf");
    let prompt = Prompt();
    let state = model({message: "Choose a scene."});
    stage.replace(stack(stretch: "both", background: "#172033") {
        column(x: 60, y: 60, gap: 24) {
            text(bind(state.message));
            button("Open prompt", on_click: || {
                if prompt.ask("Visit the observatory?") == true {
                    state.message = "The observatory opens.";
                }
            });
        };
        prompt.node;
    });
}
