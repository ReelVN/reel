fn main() {
    game.configure(title: "Local component composition", width: 720, height: 480,
        fonts: ["fonts/body.ttf"]);
    let settings = model({music: true});
    stage.replace(column(padding: 28, gap: 16) {
        text("Components can keep their state nearby", font_size: 28);
        let control = checkbox(value: bind(settings.music), width: 300, height: 64,
            decorated: false);
        control.add(stack(width: 300, height: 64,
            background: derive(|| if control.pressed { "#3d658c" }
                else if control.hover || control.focused { "#294767" } else { "#182536" })));
        control.add(text(derive(|| if settings.music { "Music on" } else { "Music off" }),
            x: 16, y: 16, font_size: 24));
        control;
        for caption in ["First card", "Second card"] {
            let card = stack(width: 300, height: 48, background: "#203047");
            card.add(text(caption, x: 16, y: 12));
            card;
        }
    });
}
