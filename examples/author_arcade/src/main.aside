// Complete paddle games composed with the same nodes and scopes as story UI.
// No external art or font files are required. Run reel dev from this project.
use game::pong;
use game::bricks;
use reel::types::Node;

fn choose_game(parent: Node) -> string {
    scope(
        owner: parent,
        body: |page| {
            page.add(
                parent,
                column(x: 260, y: 130, width: 440, gap: 24, modal: true) {
                    text("The arcade downstairs", font_size: 36, text_align: "center");
                    button(
                        "Pong",
                        on_click: || {
                            page.finish("pong");
                        }
                    );
                    button(
                        "Bricks",
                        on_click: || {
                            page.finish("bricks");
                        }
                    );
                    button(
                        "Leave",
                        on_click: || {
                            page.finish("leave");
                        }
                    );
                }
            );
            await completion();
        }
    )
}

fn main() {
    game.configure(title: "A story with an arcade", width: 960, height: 640, text_speed: 0);
    let dialogue = game.dialogue();
    let root = stack(width: 960, height: 640, background: "#0d1725") {
        stack(
            x: 40, y: 470, width: 880, height: 130, background: "#24374f",
            visible: bind(dialogue.active)
        ) {
            text(
                bind(dialogue.text), reveal: bind(dialogue.reveal), x: 24, y: 24, width: 832,
                font_size: 25
            );
        }
    };
    stage.replace(root);
    narrator("The cafe is quiet. Two arcade cabinets are still waiting for a player.");
    loop {
        let selected = choose_game(root);
        if selected == "leave" {
            break;
        }
        let result = if selected == "pong" {
            pong.play(root)
        } else {
            bricks.play(root)
        };
        narrator(f"{result.game}: {result.outcome}, with {result.score} points. Back to the cafe.");
    }
    narrator("We leave the machines for another evening.");
}
