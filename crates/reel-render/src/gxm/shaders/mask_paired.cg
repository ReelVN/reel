// Native GXM counterpart of the shared renderer algorithm.
// Top-left render targets use direct UVs; continuous varyings use TEXCOORD.
varying float4 fragment_position : WPOS;
varying out float4 reel_output : COLOR;
uniform float4 reel_clip_rect;
void reel_clip(){if(any(fragment_position.xy<reel_clip_rect.xy)||any(fragment_position.xy>=reel_clip_rect.zw))discard;}
float reel_mod(float x,float y){return x-y*floor(x/y);}
uniform sampler2D u_image0 : TEXUNIT0;
uniform sampler2D u_image1 : TEXUNIT1;
uniform float4 u_coordinates[2],u_texels[2],u_dimensions[2],u_origins[2];
uniform float4 u_ops[8];
uniform float4 u_uv0,u_uv1,u_flags;
uniform float2 u_output_size;
#ifdef REEL_MASK_COMPOSITE
varying float2 v_source_uv : TEXCOORD0;
uniform sampler2D u_source : TEXUNIT2;
uniform float4 u_params;
#endif
float3 encoded(float3 x){return lerp(1.055*pow(max(x,float3(0.0)),float3(1.0/2.4))-0.055,12.92*x,step(x,float3(0.0031308)));}
float smooth_mask(float a,float b,float x){if(a==b)return step(a,x);float t=clamp((x-a)/(b-a),0.0,1.0);return t*t*(3.0-2.0*t);}
float joined(float a,float b){if(u_flags.w==1.0)return a+b;if(u_flags.w==2.0)return a-b;return a*b;}
float chain_step(float value,float4 operation){
 if(operation.x==1.0)return value+operation.y;
 if(operation.x==2.0)return value-operation.y;
 if(operation.x==3.0)return operation.y-value;
 if(operation.x==4.0)return value*operation.y;
 if(operation.x==5.0)return operation.y==0.0?1.0:pow(max(value,0.0),operation.y);
 if(operation.x==6.0)return clamp(value,operation.y,operation.z);
 return smooth_mask(operation.y,operation.z,value);
}
float2 coordinates(float2 uv,float4 c,float4 texels,float4 dimensions,float2 origin){
 float2 at=uv*c.zw+c.xy;
 if(reel_mod(dimensions.z,2.0)>0.5)at.x=frac(at.x);
 if(dimensions.z>1.5)at.y=frac(at.y);
 float2 half_texel=0.5/dimensions.xy;
 return clamp(origin+at*texels.xy,origin+half_texel,origin+texels.xy-half_texel);
}
float alpha(float4 color,float4 texels){return texels.w==1.0?1.0:color.a;}
float gray(float4 color,float4 texels){
 if(texels.w==1.0)color.a=1.0;
 if(texels.w==2.0)color.rgb=min(color.rgb,float3(color.a));
 if(!(color.a>0.0))return 0.0;
 float3 rgb=clamp(color.rgb/color.a,0.0,1.0);
 if(texels.z==0.0)rgb=encoded(rgb);
 return dot(rgb,float3(0.2126,0.7152,0.0722));
}
void main(){
 reel_clip();
 float3 position=float3(fragment_position.xy,1.0);
 float2 uv=float2(dot(u_uv0.xyz,position),dot(u_uv1.xyz,position));
 if(any((uv<float2(0.0)))||any((uv>float2(1.0)))){reel_output=float4(0.0);return;}
 float4 first=tex2D(u_image0,coordinates(uv,u_coordinates[0],u_texels[0],u_dimensions[0],u_origins[0].xy));
#ifdef REEL_MASK_FIRST_GRAY
 float a=gray(first,u_texels[0]);
#else
 float a=alpha(first,u_texels[0]);
#endif
 float4 second=tex2D(u_image1,coordinates(uv,u_coordinates[1],u_texels[1],u_dimensions[1],u_origins[1].xy));
#ifdef REEL_MASK_SECOND_GRAY
 float b=gray(second,u_texels[1]);
#else
 float b=alpha(second,u_texels[1]);
#endif
 // A contiguous instruction stream visits the two chains and then their join.
 // Each chain has one scalar accumulator; no fragment register addressing.
 for(int i=0;i<8;i++){
  if(float(i)>=u_flags.z)break;
  if(float(i)<u_flags.x)a=chain_step(a,u_ops[i]);
  else if(float(i)<u_flags.y)b=chain_step(b,u_ops[i]);
  else {if(float(i)==u_flags.y)a=joined(a,b);a=chain_step(a,u_ops[i]);}
 }
 if(u_flags.y==u_flags.z)a=joined(a,b);
 float coverage=clamp(a,0.0,1.0);
#ifdef REEL_MASK_COMPOSITE
 reel_output=tex2D(u_source,v_source_uv)*(u_params.x*coverage);
#else
 reel_output=float4(coverage);
#endif
}
