uniform float4 u_source_uv,u_mask_uv,u_backdrop_uv,u_expression_uv;
uniform float4 u_quad_rect,u_quad_scale;
void main(float2 a_position : POSITION, float2 a_uv : TEXCOORD0,
          out float4 position : POSITION, out float2 v_source_uv : TEXCOORD0,
          out float2 v_mask_uv : TEXCOORD1, out float2 v_backdrop_uv : TEXCOORD2,
          out float2 v_expression_uv : TEXCOORD3) {
    // Integer pixel edges clip the quad before rasterization. UVs remain in the
    // original viewport grid, including cropped sources and padded storage.
    float2 pixel=a_uv*u_quad_rect.zw+u_quad_rect.xy;
    float2 uv=pixel*u_quad_scale.zw;
    position=float4(pixel*u_quad_scale.xy+float2(-1.0,1.0),0.0,1.0);
    v_mask_uv=uv*u_mask_uv.xy+u_mask_uv.zw;
    v_backdrop_uv=uv*u_backdrop_uv.xy+u_backdrop_uv.zw;
    v_expression_uv=uv*u_expression_uv.xy+u_expression_uv.zw;
    v_source_uv=uv*u_source_uv.xy+u_source_uv.zw;
}
