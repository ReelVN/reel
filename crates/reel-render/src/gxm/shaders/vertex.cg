// Bounded paint packs only color; positions, UVs and windows retain float32.
#ifdef REEL_BOUNDED
#define REEL_COLOR_SEMANTIC TEXCOORD1_HALF
#else
#define REEL_COLOR_SEMANTIC TEXCOORD1
#endif
void main(float2 a_position : POSITION, float2 a_uv : TEXCOORD0,
          float4 a_color : TEXCOORD1, float4 a_window : TEXCOORD2,
          out float4 position : POSITION, out float2 v_uv : TEXCOORD0,
          out float4 v_color : REEL_COLOR_SEMANTIC, out float4 v_window : TEXCOORD2) {
    position=float4(a_position,0.0,1.0); v_uv=a_uv; v_color=a_color; v_window=a_window;
}
