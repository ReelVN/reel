// Hardware media contracts run as an ordinary project in the production player.
// Generate the ignored resources/ inputs with the host FFmpeg installation:
// ffmpeg -f lavfi -i "sine=frequency=440:sample_rate=48000:duration=8" -ac 2 -c:a libopus resources/tone.opus
// ffmpeg -f lavfi -i "testsrc2=size=960x544:rate=30:duration=4" -f lavfi -i "sine=frequency=660:sample_rate=48000:duration=4" -c:v libx264 -profile:v baseline -level 3.1 -pix_fmt yuv420p -bf 0 -g 30 -c:a aac -ac 2 -movflags +faststart resources/movie.mp4
// ffmpeg -f lavfi -i "testsrc2=size=960x544:rate=30:duration=4" -c:v libx264 -profile:v baseline -level 3.1 -pix_fmt yuv420p -bf 0 -g 30 -an -movflags +faststart resources/silent.mp4
// Copy examples/author_arcade/resources/fonts/AtkinsonHyperlegible-Regular.ttf
// to resources/fonts/body.ttf and its OFL license beside the packaged font.
// Export with: reel export --release --resource-target vita --data-only
// The completion marker is written only after every pause/seek/loop/retire assertion.
fn wait(seconds: float) { await delay(seconds).run(); }

fn page(label: string) {
    game.configure(title: label);
    stage.replace(stack(width: 960, height: 544, background: "#152333") {
        text(label, x: 48, y: 48, font_size: 30);
        text("Automatic media check", x: 48, y: 98, font_size: 22);
    });
}

fn main() {
    game.configure(width: 960, height: 544, fonts: ["fonts/body.ttf"]);
    page("AUDIO / stream, pause, seek, resume");
    let music = audio.play("tone.opus", group: "music", looping: true, volume: 0.2);
    await music.at(1.0);
    music.pause();
    wait(0.3);
    let held = music.position();
    wait(0.3);
    if music.position() != held { throw "paused audio advanced"; }
    music.seek(6.0);
    music.resume();
    await music.at(7.0);
    wait(2.0);
    if music.position() > 7.5 { throw "audio did not loop"; }

    page("AUDIO / concurrent sound and fade");
    let sound = audio.play("tone.opus", start: 0.0, end: 0.5, volume: 0.15, pan: -0.5);
    if await sound != "Completed" { throw "sound did not complete"; }
    audio.stop(music, fade: 0.3);
    if await music != "Stopped" { throw "music did not stop"; }

    page("VIDEO / H.264 + AAC natural completion");
    let movie = video("movie.mp4", width: 960, height: 544);
    stage.replace(movie);
    if await movie.play(volume: 0.3) != "Completed" { throw "video did not complete"; }

    game.configure(title: "VIDEO / pause, seek, loop, stop");
    let playing = movie.play(looping: true, volume: 0.3);
    await playing.at(1.0);
    playing.pause();
    wait(0.3);
    let position = playing.position();
    wait(0.3);
    if playing.position() != position { throw "paused video advanced"; }
    playing.seek(3.0);
    playing.resume();
    await playing.at(3.5);
    wait(1.5);
    if playing.position() > 3.9 { throw "video did not loop"; }
    playing.stop();
    if await playing != "Stopped" { throw "video did not stop"; }

    game.configure(title: "VIDEO / silent playback and scene retirement");
    let silent = video("silent.mp4", width: 960, height: 544);
    stage.replace(silent);
    if await silent.play() != "Completed" { throw "silent video did not complete"; }
    let retired = silent.play(looping: true);
    await retired.at(0.5);
    page("MEDIA / released; reopening decoder");
    let mut cancelled = false;
    try { await retired; } catch error { cancelled = true; }
    if !cancelled { throw "removed video retained playback"; }
    wait(0.5);

    let reopened = video("movie.mp4", width: 960, height: 544);
    stage.replace(reopened);
    if await reopened.play(end: 1.0, volume: 0.3) != "Completed" {
        throw "reopened decoder did not complete";
    }
    page("MEDIA / completed");
    await persistent.write("probe-completed", true);
    wait(1.0);
    game.exit();
}
