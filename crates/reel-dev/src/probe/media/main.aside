// Synthetic media runs through the production player and platform adapters.
fn wait(seconds: float) { await run(delay(seconds)); }

fn page(label: string) {
    game.configure(title: label);
    stage.replace(stack(width: 960, height: 544, background: "#152333") {
        text(label, x: 48, y: 48, font_size: 30);
        text("Automatic media check", x: 48, y: 98, font_size: 22);
    });
}

fn main() {
    game.configure(width: 960, height: 544, fonts: ["fonts/body.ttf"]);
    page("AUDIO / stream, pause, seek, resume");
    let music = audio.play("tone.opus", group: "music", looping: true, volume: 0.2);
    await audio.at(music, 1.0);
    pause(music);
    wait(0.3);
    let held = audio.position(music);
    wait(0.3);
    if audio.position(music) != held { throw "paused audio advanced"; }
    audio.seek(music, 6.0);
    resume(music);
    await audio.at(music, 7.0);
    wait(2.0);
    if audio.position(music) > 7.5 { throw "audio did not loop"; }

    page("AUDIO / concurrent sound and fade");
    let sound = audio.play("tone.opus", start: 0.0, end: 0.5, volume: 0.15, pan: -0.5);
    if await sound != "Completed" { throw "sound did not complete"; }
    audio.stop(music, fade: 0.3);
    if await music != "Stopped" { throw "music did not stop"; }

    page("VIDEO / H.264 + AAC natural completion");
    let movie = video("movie.mp4", width: 960, height: 544);
    stage.replace(movie);
    if await movie.play(volume: 0.3) != "Completed" { throw "video did not complete"; }

    game.configure(title: "VIDEO / pause, seek, loop, stop");
    let playing = movie.play(looping: true, volume: 0.3);
    await video.at(playing, 1.0);
    pause(playing);
    wait(0.3);
    let position = video.position(playing);
    wait(0.3);
    if video.position(playing) != position { throw "paused video advanced"; }
    video.seek(playing, 3.0);
    resume(playing);
    await video.at(playing, 3.5);
    wait(1.5);
    if video.position(playing) > 3.9 { throw "video did not loop"; }
    stop(playing);
    if await playing != "Stopped" { throw "video did not stop"; }

    game.configure(title: "VIDEO / silent playback and scene retirement");
    let silent = video("silent.mp4", width: 960, height: 544);
    stage.replace(silent);
    if await silent.play() != "Completed" { throw "silent video did not complete"; }
    let retired = silent.play(looping: true);
    await video.at(retired, 0.5);
    page("MEDIA / released; reopening decoder");
    let mut cancelled = false;
    try { await retired; } catch error { cancelled = true; }
    if !cancelled { throw "removed video retained playback"; }
    wait(0.5);

    let reopened = video("movie.mp4", width: 960, height: 544);
    stage.replace(reopened);
    if await reopened.play(end: 1.0, volume: 0.3) != "Completed" {
        throw "reopened decoder did not complete";
    }
    page("MEDIA / completed");
    await persistent.write("probe-completed", true);
    wait(1.0);
    game.exit();
}
