// Reviewed Aside syntax conversion; parse and analysis fixture.
// Valid syntax: Closures and scoping

// Basic closure
let mut outer_val = 10;
let closure = || {
    return outer_val;
};
assert(closure() == 10);

// Closure captures by reference
outer_val = 20;
assert(closure() == 20);

// Nested closures
fn make_multiplier(factor) {
    return |x| {
        return x * factor;
    };
}
let double_fn = make_multiplier(2);
let triple_fn = make_multiplier(3);
assert(double_fn(5) == 10);
assert(triple_fn(5) == 15);

// Closure over loop variable
let mut fns = [];
for i in 0..5 {
    let captured_i = i; // capture by value
    fns.append(|| captured_i);
}
assert(fns[0]() == 0);
assert(fns[4]() == 4);

// Nested function accessing outer scope
fn outer() {
    let mut x = 100;
    fn inner() {
        return x + 1;
    }
    return inner();
}
assert(outer() == 101);

// Deep nesting
fn level1() {
    let mut a_val = 1;
    fn level2() {
        let mut b_val = 2;
        fn level3() {
            return a_val + b_val;
        }
        return level3();
    }
    return level2();
}
assert(level1() == 3);

// Function returning table of closures
fn make_stack() {
    let mut data = [];
    return {
        push: |v| { data.append(v); },
        pop: || { return data.pop(); },
        size: || { return data.len(); },
        peek: || { return data[data.len() - 1]; },
    };
}

let stack = make_stack();
stack.push(1);
stack.push(2);
stack.push(3);
assert(stack.size() == 3);
assert(stack.peek() == 3);
assert(stack.pop() == 3);
assert(stack.size() == 2);

// IIFE (Immediately Invoked Function Expression)
let iife_result = (|| {
    return 42;
})();
assert(iife_result == 42);

// Lambda IIFE
let lambda_iife = (|| 99)();
assert(lambda_iife == 99);

// Block scope isolation
{
    let mut scoped = 42;
    assert(scoped == 42);
}

// Multiple blocks
{
    let mut a_block = 1;
    {
        let mut b_block = 2;
        assert(a_block == 1);
        assert(b_block == 2);
    }
}

print("closures_scope: OK\n");
