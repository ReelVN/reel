// Migrated from Quirrel testData/exec/opt/opt_reassign_addi.nut; original oracle and assertions retained.
// Test: reassigned let mut used in ADDI fold (2-instruction fold: LOAD, ADDI)
// The peephole folds LOADINT+MOVE into LOADINT targeting the local's register.
// The ADDI fold must not replace that LOADINT with a result targeting a different register.

// Pattern: let mut x = A; x = B; let mut y = x + C + D
// After peephole: LOADINT x_reg B, ADDI y_reg C x_reg, ADDI y_reg D y_reg
// The first ADDI fold must not destroy x's value.

{
  let mut v1 = -111;
  v1 = 3;
  let mut loop2 = v1 - -5 + 12;
  assert(v1 == 3, f"expected v1==3, got {v1}");
  assert(loop2 == 20, f"expected loop2==20, got {loop2}");
}

{
  let mut a = 100;
  a = 5;
  let mut b = a + 10;
  assert(a == 5, f"expected a==5, got {a}");
  assert(b == 15, f"expected b==15, got {b}");
}

{
  let mut a = 100;
  a = 5;
  let mut b = a + 10 + 20;
  assert(a == 5, f"expected a==5, got {a}");
  assert(b == 35, f"expected b==35, got {b}");
}

// Chain of ADDI folds
{
  let mut x = -1;
  x = 7;
  let mut y = x + 1 + 2 + 3;
  assert(x == 7, f"expected x==7, got {x}");
  assert(y == 13, f"expected y==13, got {y}");
}

// Negative immediates
{
  let mut x = 999;
  x = 20;
  let mut y = x - 5 - 3;
  assert(x == 20, f"expected x==20, got {x}");
  assert(y == 12, f"expected y==12, got {y}");
}

println("opt_reassign_addi: OK");
