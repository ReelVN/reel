// Reviewed syntax migration; original assertions and output are retained.
let mut totalDamage = 0;
for shot in 0..5 { totalDamage += 10 + shot; }
println(f"total damage: {totalDamage}");
{ let mut front = 0; let mut back = 4;
  while front < back { println(f"swap {front} <-> {back}"); front += 1; back -= 1; }
}
