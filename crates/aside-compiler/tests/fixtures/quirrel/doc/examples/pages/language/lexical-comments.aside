// Reviewed syntax migration; original assertions and output are retained.
// a line comment runs to the end of the line
let reloadSeconds = 2; // trailing comments work the same way
/* a block comment
   can span several lines */
let squadStrength = 4;
println(reloadSeconds + squadStrength);
