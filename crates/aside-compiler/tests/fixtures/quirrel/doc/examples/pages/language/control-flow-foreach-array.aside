// Reviewed syntax migration; original assertions and output are retained.
let squadMembers = ["driver", "gunner", "loader"];
println("squadMembers roles:");
for role in squadMembers { println(role); }
for seat in 0..squadMembers.len() { let role = squadMembers[seat]; println(f"seat {seat}: {role}"); }
