// Upstream: 19f17df9b6ee43c91ef5c635fd45970ec76c5dbe; license: third_party/quirrel/COPYRIGHT
// Reviewed syntax conversion. Aside execution: waiting_runtime.
// there is no 'finally': cleanup that must always run goes right here,
// then a bare 'throw e' rethrows the same value onward
fn deploySquad() {
  println("releasing staging area lock");
  try {
    throw "landing zone is hot";
  } catch e {
    println("logged:", e);
    throw e;
  }
}

try {
  deploySquad();
} catch e {
  println("mission control caught:", e);
}
