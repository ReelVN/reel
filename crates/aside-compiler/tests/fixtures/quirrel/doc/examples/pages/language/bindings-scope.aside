// Reviewed syntax migration; original assertions and output are retained.
fn announce(range) { println(f"contact at {range}m"); }
{ let range = 400; announce(range); }
{ let range = 250; announce(range); }
let range = 999;
fn closest(range) { return range; }
println("closest(10) =", closest(10));
println("range =", range);
