let ammoLeft = 0;
println("ammoLeft ?? ammoLeft > 0 =", ammoLeft ?? ammoLeft > 0);
println("1 << 2 == 4 =", 1 << 2 == 4);
let squadReady = true;
let hasFuel = false;
let override = true;
println("squadReady && hasFuel || override =", squadReady && hasFuel || override);
