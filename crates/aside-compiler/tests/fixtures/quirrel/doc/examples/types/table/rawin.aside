// Reviewed Aside syntax conversion; parse and analysis fixture.
let t = {a:1, b:null};
println("t.rawin(\"a\") =", t.has_own("a"));
println("t.rawin(\"missing\") =", t.has_own("missing"));
println("t.rawin(\"b\") =", t.has_own("b"));       // present with a null value: still true
println("\"a\" in t:", t.has_own("a"));           // the 'in' operator agrees for a plain table
