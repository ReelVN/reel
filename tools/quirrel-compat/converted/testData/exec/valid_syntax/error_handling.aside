// Source: third_party/quirrel/testData/exec/valid_syntax/error_handling.nut
// Upstream: 19f17df9b6ee43c91ef5c635fd45970ec76c5dbe; license: third_party/quirrel/COPYRIGHT
// Reviewed syntax conversion. Aside execution: waiting_runtime.
// Valid syntax: Error handling (try/catch/throw)

// Basic try/catch
let mut caught = null;
try {
    throw "test error";
} catch e {
    caught = e;
}
assert(caught == "test error");

// Catching runtime errors
let mut rt_caught = false;
try {
    let t = {};
    let _ = t.nonexistent_method();
} catch e {
    rt_caught = true;
}
assert(rt_caught);

// Throw integer
let mut int_err = null;
try {
    throw 42;
} catch e {
    int_err = e;
}
assert(int_err == 42);

// Throw null
let mut null_err = "not null";
try {
    throw null;
} catch e {
    null_err = e;
}
assert(null_err == null);

// Throw table
let mut tbl_err = null;
try {
    throw {code: 404, message: "Not found"};
} catch e {
    tbl_err = e;
}
assert(tbl_err.code == 404);

// Nested try/catch
let mut outer_caught = null;
let mut inner_caught = null;
try {
    try {
        throw "inner";
    } catch e {
        inner_caught = e;
        throw "outer";
    }
} catch e {
    outer_caught = e;
}
assert(inner_caught == "inner");
assert(outer_caught == "outer");

// Try/catch with no exception
let mut no_err = true;
try {
    let x = 42;
} catch e {
    no_err = false;
}
assert(no_err);

// Function that may throw
fn divide(a, b) {
    if b == 0 { throw "division by zero"; }
    return a / b;
}

assert(divide(10, 2) == 5);

let mut div_err = null;
try {
    divide(10, 0);
} catch e {
    div_err = e;
}
assert(div_err == "division by zero");

// Try/catch in loop
let mut errors_caught = 0;
for i in 0..5 {
    try {
        if i % 2 == 0 { throw "even error"; }
    } catch e {
        errors_caught += 1;
    }
}
assert(errors_caught == 3); // 0, 2, 4

// Rethrow
let mut rethrown = null;
try {
    try {
        throw "original";
    } catch e {
        throw e; // rethrow
    }
} catch e {
    rethrown = e;
}
assert(rethrown == "original");

print("error_handling: OK\n");
