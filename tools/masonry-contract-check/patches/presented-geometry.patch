+// Copyright 2026 the Xilem Authors and Reel contributors
+// SPDX-License-Identifier: Apache-2.0
+
+//! Experimental affine/rectangular presented geometry, confined to the contract probe.
+use super::RenderRoot;
+use crate::core::{WidgetId, WidgetState};
+use kurbo::{Point, Rect};
+use std::{collections::HashMap, sync::Arc};
+
+#[derive(Clone, Debug)]
+struct Entry {
+    state: WidgetState,
+    children: Vec<WidgetId>,
+    path: Vec<WidgetId>,
+}
+
+/// Frozen geometry and topology of one recorded frame. No widget objects are cloned.
+/// This prototype intentionally clones WidgetState; production should project geometry fields.
+#[derive(Clone, Debug)]
+pub struct PresentedGeometryView {
+    frame_id: u64,
+    scale_factor: f64,
+    root_id: WidgetId,
+    entries: HashMap<WidgetId, Entry>,
+}
+impl PresentedGeometryView {
+    /// Identity supplied by the experiment's presentation gate.
+    pub fn frame_id(&self) -> u64 {
+        self.frame_id
+    }
+    /// Number of frozen widgets.
+    pub fn len(&self) -> usize {
+        self.entries.len()
+    }
+    /// Whether there are no widgets.
+    pub fn is_empty(&self) -> bool {
+        self.entries.is_empty()
+    }
+    /// Payload lower bound, excluding HashMap buckets and nested state allocations.
+    pub fn retained_bytes_lower_bound(&self) -> usize {
+        self.entries
+            .values()
+            .map(|e| {
+                size_of::<Entry>()
+                    + (e.children.capacity() + e.path.capacity()) * size_of::<WidgetId>()
+            })
+            .sum()
+    }
+    pub(crate) fn state(&self, id: WidgetId) -> &WidgetState {
+        &self
+            .entries
+            .get(&id)
+            .expect("input queried geometry absent from selected presented frame")
+            .state
+    }
+    pub(crate) fn path(&self, id: WidgetId) -> Vec<WidgetId> {
+        self.entries
+            .get(&id)
+            .map(|e| e.path.clone())
+            .unwrap_or_default()
+    }
+    pub(crate) fn layer_ids(&self) -> Vec<WidgetId> {
+        self.entries[&self.root_id].children.clone()
+    }
+    pub(crate) fn scale_factor(&self) -> f64 {
+        self.scale_factor
+    }
+    /// Hit only the immutable view; current eligibility is checked afterwards by RenderRoot.
+    /// Rectangular default policy; custom hit callbacks need a frozen author mapping.
+    pub fn hit_test(&self, pos: Point) -> Option<WidgetId> {
+        fn hit(view: &PresentedGeometryView, id: WidgetId, pos: Point) -> Option<WidgetId> {
+            let entry = &view.entries[&id];
+            let s = &entry.state;
+            let transform = s.window_transform;
+            if s.is_stashed
+                || !transform.as_coeffs().iter().all(|v| v.is_finite())
+                || !transform.determinant().is_finite()
+                || transform.determinant() == 0.
+            {
+                return None;
+            }
+            let local = transform.inverse() * pos;
+            if !local.x.is_finite()
+                || !local.y.is_finite()
+                || !s.bounding_box.contains(pos)
+                || s.clip_path.is_some_and(|c| !c.contains(local))
+            {
+                return None;
+            }
+            if s.propagates_pointer_interaction {
+                for child in entry.children.iter().rev() {
+                    if let Some(id) = hit(view, *child, pos) {
+                        return Some(id);
+                    }
+                }
+            }
+            (s.accepts_pointer_interaction && s.border_box().contains(local)).then_some(id)
+        }
+        hit(self, self.root_id, pos)
+    }
+    /// Content-box geometry for audit assertions.
+    pub fn content_box(&self, id: WidgetId) -> Rect {
+        let s = self.state(id);
+        s.content_box() - s.border_box_translation()
+    }
+}
+impl RenderRoot {
+    /// Capture after layout/recording; capture does not accept the frame.
+    pub fn capture_presented_geometry(&self, frame_id: u64) -> Arc<PresentedGeometryView> {
+        fn visit(
+            root: &RenderRoot,
+            id: WidgetId,
+            parent_path: &[WidgetId],
+            entries: &mut HashMap<WidgetId, Entry>,
+        ) {
+            let node = root.widget_arena.get_node(id);
+            let children: Vec<_> = node.item.widget.children_ids().into_iter().collect();
+            let mut path = vec![id];
+            path.extend_from_slice(parent_path);
+            entries.insert(
+                id,
+                Entry {
+                    state: node.item.state.clone(),
+                    children: children.clone(),
+                    path: path.clone(),
+                },
+            );
+            for child in children {
+                visit(root, child, &path, entries);
+            }
+        }
+        let mut entries = HashMap::new();
+        visit(self, self.root_id(), &[], &mut entries);
+        Arc::new(PresentedGeometryView {
+            frame_id,
+            scale_factor: self.global_state.scale_factor,
+            root_id: self.root_id(),
+            entries,
+        })
+    }
+    /// Install only after the host accepts this exact frame. Recompute stationary hover.
+    pub fn set_presented_geometry(&mut self, view: Arc<PresentedGeometryView>) {
+        self.global_state.last_mouse_pos = self
+            .global_state
+            .last_pointer_physical
+            .map(|p| p.to_logical(view.scale_factor));
+        self.global_state.presented_geometry = Some(view);
+        self.global_state.needs_pointer_pass = true;
+        crate::passes::update::run_update_pointer_pass(self);
+        self.run_rewrite_passes();
+    }
+    pub(crate) fn pointer_hit_test(&self, pos: Point) -> Option<WidgetId> {
+        let target = if let Some(view) = &self.global_state.presented_geometry {
+            view.hit_test(pos)
+        } else {
+            self.get_widget(self.root_id())
+                .unwrap()
+                .find_widget_under_pointer(pos)
+                .map(|w| w.id())
+        };
+        // Disabled widgets remain hit targets so the event pass can skip their behavior
+        // and bubble through the selected ancestor route. Capture eligibility is separate.
+        target.filter(|id| {
+            self.widget_arena
+                .nodes
+                .find(*id)
+                .is_some_and(|node| !node.item.state.is_stashed)
+        })
+    }
+    pub(crate) fn input_path(&self, id: WidgetId) -> Vec<WidgetId> {
+        if self.global_state.input_geometry_active {
+            if let Some(view) = &self.global_state.presented_geometry {
+                return view.path(id);
+            }
+        }
+        self.widget_arena
+            .nodes
+            .get_id_path(id)
+            .iter()
+            .map(|id| WidgetId((*id).try_into().unwrap()))
+            .collect()
+    }
+}
